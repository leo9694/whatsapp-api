generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  CONNECTING
  ACTIVE
  REJECTED
  MISSED
  BUSY
  FAILED
  ENDED
}

enum CallTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum CallPermissionStatus {
  PENDING
  GRANTED
  DENIED
  EXPIRED
  REVOKED
}

model Contact {
  id            Int            @id @default(autoincrement())
  waId          String         @unique
  phone         String
  name          String?
  profileName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  calls         Call[]
  callPermissions CallPermission[]
}

model WhatsAppChannel {
  id                 Int              @id @default(autoincrement())
  phoneNumberId      String           @unique
  displayPhoneNumber String
  displayName        String
  wabaId             String?
  isActive           Boolean          @default(true)
  isDefault          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  conversations      Conversation[]
  calls              Call[]
  callPermissions    CallPermission[]

  @@index([isActive, isDefault])
}

model Conversation {
  id                             Int                      @id @default(autoincrement())
  contactId                      Int
  channelId                      Int
  status                         ConversationStatus       @default(OPEN)
  assignedUserId                 String?
  assignedUserName               String?
  assignedAt                     DateTime?
  phoneNumberId                  String?
  unreadCount                    Int                      @default(0)
  lastMessageAt                  DateTime?
  conversationInitiated          Boolean                  @default(false)
  conversationInitiatedAt        DateTime?
  initialTemplateWamid           String?
  initialTemplateStatus          MessageStatus?
  lastInboundAt                  DateTime?
  customerServiceWindowOpenedAt  DateTime?
  customerServiceWindowExpiresAt DateTime?
  waitingForCustomerReply        Boolean                  @default(false)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  contact                        Contact                  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  channel                        WhatsAppChannel          @relation(fields: [channelId], references: [id], onDelete: Restrict)
  messages                       Message[]
  assignments                    ConversationAssignment[]
  calls                          Call[]
  callPermissions                CallPermission[]

  @@index([contactId])
  @@index([contactId, channelId, status])
  @@index([channelId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([initialTemplateWamid])
  @@index([customerServiceWindowExpiresAt])
}

model CallPermission {
  id                   Int                  @id @default(autoincrement())
  conversationId       Int
  contactId            Int
  channelId            Int
  phoneNumberId        String
  status               CallPermissionStatus
  canStartCall         Boolean              @default(false)
  isPermanent          Boolean              @default(false)
  metaStatus           String?
  responseSource       String?
  requestedByAgentId   String?
  requestedByAgentName String?
  requestedAt          DateTime?
  grantedAt            DateTime?
  deniedAt             DateTime?
  revokedAt            DateTime?
  expiresAt            DateTime?
  metaReference        String?
  lastWebhookWamid     String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  conversation         Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact              Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel              WhatsAppChannel      @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([conversationId, phoneNumberId])
  @@index([contactId, phoneNumberId])
  @@index([channelId, status])
  @@index([status, expiresAt])
}

model Call {
  id              Int           @id @default(autoincrement())
  metaCallId      String        @unique
  conversationId  Int?
  contactId       Int?
  channelId       Int
  phoneNumberId   String
  direction       CallDirection
  status          CallStatus
  remotePhone     String?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  endReason       String?
  lastEventAt     DateTime?
  currentAgentId  String?
  currentAgentName String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel         WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  transfers       CallTransfer[]

  @@index([conversationId, createdAt])
  @@index([contactId, createdAt])
  @@index([phoneNumberId, status])
  @@index([channelId, status])
  @@index([direction, status, createdAt])
  @@index([currentAgentId, status])
}

model CallTransfer {
  id            String             @id @default(uuid())
  callId        Int
  fromAgentId   String
  fromAgentName String
  toAgentId     String
  toAgentName   String
  status        CallTransferStatus @default(PENDING)
  requestedAt   DateTime           @default(now())
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  cancelledAt   DateTime?
  mediaReadyAt  DateTime?
  completedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  call          Call               @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, requestedAt])
  @@index([toAgentId, status])
  @@index([status, expiresAt])
}

model Message {
  id                 Int              @id @default(autoincrement())
  wamid              String?          @unique
  conversationId     Int
  direction          MessageDirection
  type               String
  text               String?
  mediaId            String?
  mediaUrl           String?
  mimeType           String?
  filename           String?
  caption            String?
  mediaSha256        String?
  voice              Boolean?
  durationSeconds    Int?
  templateName       String?
  templateLanguage   String?
  templateComponents Json?
  templateData       Json?
  renderedText       String?
  replyContext       Json?
  senderUserId       String?
  senderUserName     String?
  status             MessageStatus
  messageTimestamp   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageTimestamp])
  @@index([conversationId, messageTimestamp])
}

model ConversationAssignment {
  id             Int          @id @default(autoincrement())
  conversationId Int
  action         String
  actorUserId    String
  actorUserName  String
  targetUserId   String?
  targetUserName String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
